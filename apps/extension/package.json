{
  "name": "@bezbrehni/extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node build.mjs --watch",
    "build": "node build.mjs",
    "zip": "node build.mjs && node -e \"import('node:child_process').then(({execSync})=>execSync('cd dist && zip -r ../bezbrehni-extension.zip .',{stdio:'inherit'})\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo skip"
  },
  "dependencies": {
    "@bezbrehni/shared": "workspace:*",
    "@bezbrehni/ui": "workspace:*",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "0.0.280",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "esbuild": "0.24.0",
    "typescript": "5.6.3"
  }
}
