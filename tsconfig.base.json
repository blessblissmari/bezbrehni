{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": false,
    "sourceMap": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@bezbrehni/shared": ["packages/shared/src/index.ts"],
      "@bezbrehni/shared/*": ["packages/shared/src/*"],
      "@bezbrehni/ai": ["packages/ai/src/index.ts"],
      "@bezbrehni/ai/*": ["packages/ai/src/*"],
      "@bezbrehni/ui": ["packages/ui/src/index.ts"],
      "@bezbrehni/ui/*": ["packages/ui/src/*"]
    }
  }
}
