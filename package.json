{
  "name": "bezbrehni",
  "version": "0.1.0",
  "private": true,
  "description": "Безбрехни — AI-расширение для проверки контента (MVP)",
  "packageManager": "pnpm@9.15.1",
  "scripts": {
    "dev:web": "pnpm --filter @bezbrehni/web dev",
    "dev:ext": "pnpm --filter @bezbrehni/extension dev",
    "dev:api": "pnpm --filter @bezbrehni/api dev",
    "build": "pnpm -r --workspace-concurrency=1 run build",
    "build:web": "pnpm --filter @bezbrehni/web build",
    "build:ext": "pnpm --filter @bezbrehni/extension build",
    "build:api": "pnpm --filter @bezbrehni/api build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm -r run lint",
    "clean": "pnpm -r exec rm -rf dist .next out node_modules/.cache"
  },
  "devDependencies": {
    "@types/node": "20.16.5",
    "typescript": "5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}
