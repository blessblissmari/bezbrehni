-- Схема YDB для Безбрехни. Применяется скриптом infra/scripts/apply-ydb-schema.sh.
-- YDB Serverless: все колонки Utf8 кроме числовых / timestamps.

CREATE TABLE IF NOT EXISTS users (
    id Utf8 NOT NULL,
    email Utf8 NOT NULL,
    password_hash Utf8 NOT NULL,
    created_at Utf8 NOT NULL,
    PRIMARY KEY (id),
    INDEX by_email GLOBAL ON (email)
);

CREATE TABLE IF NOT EXISTS entitlements (
    user_id Utf8 NOT NULL,
    plan Utf8 NOT NULL,
    pro_until Utf8,
    PRIMARY KEY (user_id)
);

CREATE TABLE IF NOT EXISTS usage_events (
    id Utf8 NOT NULL,
    user_id Utf8 NOT NULL,
    kind Utf8 NOT NULL,
    created_at Utf8 NOT NULL,
    PRIMARY KEY (id),
    INDEX by_user GLOBAL ON (user_id)
);

CREATE TABLE IF NOT EXISTS payments (
    id Utf8 NOT NULL,
    user_id Utf8 NOT NULL,
    yookassa_id Utf8 NOT NULL,
    status Utf8 NOT NULL,
    amount Double NOT NULL,
    currency Utf8 NOT NULL,
    created_at Utf8 NOT NULL,
    paid_at Utf8,
    -- Выставляется в TRUE после того, как платёж применён к entitlement'у.
    -- Отдельно от `status`, потому что запись succeeded-платежа и апгрейд тарифа —
    -- две независимые операции, и webhook может повторно прийти между ними.
    entitlement_applied Bool,
    PRIMARY KEY (id),
    INDEX by_user GLOBAL ON (user_id),
    INDEX by_yookassa GLOBAL ON (yookassa_id)
);

CREATE TABLE IF NOT EXISTS analyses (
    id Utf8 NOT NULL,
    user_id Utf8 NOT NULL,
    verdict Utf8 NOT NULL,
    text_preview Utf8 NOT NULL,
    page_url Utf8,
    created_at Utf8 NOT NULL,
    PRIMARY KEY (id),
    INDEX by_user GLOBAL ON (user_id)
);
